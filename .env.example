# Copy this file to a new file named ".env" and fill in real values.
# NEVER commit ".env" to Git (it must be in .gitignore).

DB_PASSWORD=deepu@123

# At least 32 characters, random. Ways to make one:
#   Git Bash / Linux / Mac:  openssl rand -base64 48
#   PowerShell:              -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 48 | ForEach-Object {[char]$_})
JWT_SECRET=change_me_to_a_long_random_text_of_at_least_32_characters

# The first admin (needs 8+ characters with a letter and a number). Leave empty to skip.
ADMIN_EMAIL=admin@securebank.com
ADMIN_PASSWORD=admin@123
