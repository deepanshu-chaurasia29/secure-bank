# Copy to .env for local development, then fill in your own values.
# Never commit .env or paste real credentials into documentation/screenshots.

DB_URL=jdbc:mysql://localhost:3306/securebank?createDatabaseIfNotExist=true
DB_USER=root
DB_PASSWORD=deepu@123

# Generate a unique value of 32+ characters for local use. For production, set it in Render.
# Git Bash / Linux / macOS: openssl rand -base64 48
# PowerShell: use the command in docs/DEPLOYMENT_GUIDE.md
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Optional: used only when the first admin needs to be created.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin@123

APP_TZ=Asia/Kolkata
DB_POOL_SIZE=5
DB_SCHEMA_INIT_MODE=always
